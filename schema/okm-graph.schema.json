{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://okm-orgknowledgemodel.github.io/okm/schema/okm-graph.schema.json",
  "title": "OKM export (Organisation Knowledge Model) 0.1",
  "type": "object",
  "required": [
    "okmVersion",
    "nodes",
    "edges"
  ],
  "properties": {
    "@context": {},
    "okmVersion": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "publisher": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "description": "Declared subclasses and sub-properties",
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "subClassOf"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "subClassOf": {
                "enum": [
                  "Organisation",
                  "Unit",
                  "Role",
                  "Agent",
                  "Function",
                  "Task",
                  "Competence",
                  "Rule",
                  "Document",
                  "Service",
                  "Process",
                  "Step",
                  "System",
                  "Dataset",
                  "Goal",
                  "Measure",
                  "Indicator",
                  "BudgetLine",
                  "Term",
                  "Place"
                ]
              },
              "definition": {
                "type": "string"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "subPropertyOf"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "subPropertyOf": {
                "enum": [
                  "partOf",
                  "supervisedBy",
                  "roleIn",
                  "holds",
                  "responsibleFor",
                  "performs",
                  "hasCompetence",
                  "partOfFunction",
                  "establishes",
                  "contains",
                  "amends",
                  "supersedes",
                  "implements",
                  "realises",
                  "hasStep",
                  "invokes",
                  "uses",
                  "produces",
                  "contributesTo",
                  "measures",
                  "funds",
                  "defines",
                  "classifiedAs",
                  "broader",
                  "locatedIn"
                ]
              },
              "definition": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "iri": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "class",
        "label",
        "source",
        "recordedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "class": {
          "type": "string",
          "description": "A core class or a subclass declared in extensions"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scheme",
              "value"
            ],
            "properties": {
              "scheme": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "validTo": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "status",
        "source",
        "method",
        "recordedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "predicate": {
          "type": "string"
        },
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "status": {
          "enum": [
            "source",
            "derived",
            "proposed",
            "confirmed",
            "rejected"
          ]
        },
        "basis": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "method": {
          "enum": [
            "extracted",
            "rule",
            "model",
            "manual"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewedBy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "validTo": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            }
          },
          "then": {
            "required": [
              "confidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "confirmed",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reviewedBy",
              "reviewedAt"
            ]
          }
        }
      ]
    }
  }
}